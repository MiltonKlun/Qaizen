{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "tests/**/*.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "examples/**/*.probe.mjs"
  ],
  "exclude": ["node_modules"]
}
