# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# ----------------------------------------------------------------------------
# Atlassian (Jira + Confluence) via mcp-atlassian, read-only mode
# ----------------------------------------------------------------------------

# Jira Cloud base URL, e.g. https://your-domain.atlassian.net
JIRA_URL=https://your-domain.atlassian.net

# Atlassian account email and API token used by the deterministic Jira
# scripts (story fetch, bug and test-case promotion with --apply).
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_USERNAME=
JIRA_API_TOKEN=

# The read-only Atlassian MCP server (`atlassian` in .mcp.json) uses its own
# credential for Jira and Confluence. Use an account that can only read the
# projects and spaces the pipeline needs, so no agent session holds a token
# that can write. Until you have one, these may repeat the values above.
ATLASSIAN_READ_USERNAME=
ATLASSIAN_READ_API_TOKEN=

# Default Jira project key, e.g. "PROJ" or "QA"
JIRA_PROJECT_KEY=

# Optional, for stories fetched from Jira (npm run pipeline -- --story KEY).
# The id of a custom field that holds acceptance criteria, if your project
# keeps them outside the description (e.g. customfield_10045); it gets its own
# section in story.md.
JIRA_AC_FIELD=
# true to add the issue's comments to story.md, marked as context only (a rule
# found only in a comment is a Gate 1 ambiguity, never a criterion).
JIRA_STORY_COMMENTS=

# Confluence (may share the same Atlassian site as Jira); read through the
# MCP server with the ATLASSIAN_READ_* credential above.
CONFLUENCE_URL=

# ----------------------------------------------------------------------------
# Application under test
# ----------------------------------------------------------------------------

# Base URL of the application that Playwright will exercise
BASE_URL=

# ----------------------------------------------------------------------------
# MCP Atlassian tool allowlist (read-only, in every phase)
# ----------------------------------------------------------------------------
# Only read tools. Writes (jira_create_issue, jira_update_issue,
# jira_add_comment, etc.) are not in this list, and the server also runs with
# READ_ONLY_MODE, so they fail at the MCP layer if an agent attempts them.

ENABLED_TOOLS=jira_get_issue,jira_search,jira_get_link_types,confluence_get_page,confluence_search

# ----------------------------------------------------------------------------
# API branch (Postman MCP + Newman)
# ----------------------------------------------------------------------------

# Postman API key, from https://go.postman.co/settings/me/api-keys
# Used by the official @postman/postman-mcp-server (local STDIO mode) so the
# API Agent can read/write collections. Newman execution itself does not need
# this key (it runs collection files directly from disk).
POSTMAN_API_KEY=

# Optional: the Postman workspace the API Agent should read/write collections
# in. Leave blank to use the account default.
POSTMAN_WORKSPACE_ID=

# Base URL for the API under test. The API branch targets reqres.in because
# Saucedemo has no real backend API (docs/design-decisions.md D3).
# Collections reference this via an environment variable, never hardcoded.
API_BASE_URL=https://reqres.in/api

# reqres.in now requires a free x-api-key header on all /api/* endpoints.
# Get one at https://app.reqres.in/api-keys. The Newman environment reads it
# as {{api_key}} and sends it as the x-api-key header; never hardcode it in
# the collection (docs/design-decisions.md D5).
REQRES_API_KEY=

# ----------------------------------------------------------------------------
# TestLink (test management) via the XML-RPC sync scripts
# ----------------------------------------------------------------------------
# TestLink is self-hosted; the pipeline does not install it. See
# docs/testlink-integration.md and docs/secrets-management.md.

# Base URL of your TestLink instance, e.g. https://testlink.example.com
TESTLINK_URL=

# TestLink API key: in TestLink, User Settings -> Generate a new API key.
TESTLINK_API_KEY=

# The TestLink project the pipeline syncs test cases into.
TESTLINK_PROJECT_KEY=

# The TestLink test plan that execution results are reported against.
TESTLINK_TEST_PLAN_ID=

# ----------------------------------------------------------------------------
# Jira writes
# ----------------------------------------------------------------------------
# No MCP server can write to Jira. Bugs and test cases reach Jira only through
# the deterministic scripts, which a human runs with an explicit --apply
# (e.g. `node scripts/create-jira-bugs.js --apply`), using JIRA_USERNAME and
# JIRA_API_TOKEN above.

# Issue type used when promoting bug drafts to Jira (configurable; default Bug).
JIRA_BUG_ISSUETYPE=Bug

# Pluggable test-case destination (TestManagementAdapter port).
# Which tool the test-case sync writes to: testlink | jira | both | none.
# Each adapter runs only when this selects it: scripts/sync-to-testlink.js
# needs testlink or both, scripts/create-jira-testcases.js needs jira or both.
# See agents/test-management-adapter.md.
TEST_MANAGEMENT_TOOL=testlink

# Timeout for each Jira / TestLink request, in milliseconds (100-120000).
# Optional; default 30000. See docs/sync-recovery.md.
QAIZEN_HTTP_TIMEOUT_MS=

# Issue type for test cases created in Jira. MUST be a type your
# Jira project actually has — many sites have no "Test" type; "Task" is a safe
# default. (Verified: the SK demo project only has Task, not Test.)
JIRA_TESTCASE_ISSUETYPE=Task

# Code-change awareness (GitHub MCP, READ-ONLY).
# A fine-grained PAT scoped to READ pull requests + contents on the repo(s)
# whose PRs your Jira stories link to. The Analyst (Mode B) uses it to fetch a
# linked PR's diff as SECONDARY context only — never to define expected
# behavior, and never to write to GitHub. Optional: with no linked PR, the
# pipeline runs identically and this is unused.
GITHUB_PERSONAL_ACCESS_TOKEN=
# The server's tools are fixed in .mcp.json, not here: GITHUB_TOOLS lists the
# three read tools the Analyst needs, GITHUB_READ_ONLY=1 disables every write
# tool, and GITHUB_LOCKDOWN_MODE=1 surfaces public-repository content only
# when its author has push access (a prompt-injection filter, not a security
# boundary).
