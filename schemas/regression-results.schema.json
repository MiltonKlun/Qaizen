{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qaizen/schemas/regression-results.schema.json",
  "title": "Agent regression evaluation results",
  "description": "What scripts/evaluate-agents.js --regressions measured on one set of trials (evidence/regressions/<agent|all>.json): per case the trials passed, pass^k and a Wilson 95% interval on the pass rate; the share of cases passing every trial; the prompts and model behind the trials; the comparison with the previous results for the same scope and the decision the pre-registered rule gives. The file is rewritten only when what it measured changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "generated_at",
    "scope",
    "decision_rule",
    "provenance",
    "aggregate",
    "previous",
    "decision",
    "cases"
  ],
  "definitions": {
    "interval": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      ]
    },
    "rate": {
      "type": "object",
      "required": ["value", "wilson_95"],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ]
        },
        "wilson_95": {
          "$ref": "#/definitions/interval"
        }
      }
    },
    "promptDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ]
        }
      }
    }
  },
  "properties": {
    "kind": {
      "const": "regression-evaluation"
    },
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "agents", "cases", "trials"],
      "properties": {
        "agent": {
          "description": "The --agent the run was limited to, or null for every agent.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": ["analyst", "test-designer", "healer"]
            }
          ]
        },
        "agents": {
          "type": "array",
          "items": {
            "enum": ["analyst", "test-designer", "healer"]
          }
        },
        "cases": {
          "type": "integer",
          "minimum": 1
        },
        "trials": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "decision_rule": {
      "type": "object",
      "required": [
        "statement",
        "block_when_a_case_fails_every_trial",
        "block_below_previous_lower_bound",
        "sha256",
        "set_tree"
      ],
      "properties": {
        "statement": {
          "type": "string"
        },
        "block_when_a_case_fails_every_trial": {
          "type": "boolean"
        },
        "block_below_previous_lower_bound": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the committed manifest (line endings normalized): the rule, the trial count and the cases together."
        },
        "set_tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$",
          "description": "The git tree of examples/evaluation/regressions at HEAD when the evaluation ran: the cases, their inputs and the rule exactly as committed."
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "harness", "prompts"],
      "properties": {
        "model": {
          "type": "string",
          "description": "QAIZEN_MODEL when the evaluation ran; the evaluator refuses to run without it."
        },
        "harness": {
          "type": "string"
        },
        "prompts": {
          "type": "object",
          "propertyNames": {
            "enum": ["analyst", "test-designer", "healer"]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/promptDigest"
            }
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "required": ["pass_k", "per_trial"],
      "properties": {
        "pass_k": {
          "allOf": [
            {
              "$ref": "#/definitions/rate"
            },
            {
              "type": "object",
              "required": ["cases", "passed"],
              "properties": {
                "cases": {
                  "type": "integer",
                  "minimum": 1
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "per_trial": {
          "allOf": [
            {
              "$ref": "#/definitions/rate"
            },
            {
              "type": "object",
              "required": ["trials", "passed"],
              "properties": {
                "trials": {
                  "type": "integer",
                  "minimum": 1
                },
                "passed": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        }
      }
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "pass_k",
            "cases_added",
            "cases_removed",
            "set_changed",
            "compared"
          ],
          "properties": {
            "source": {
              "type": "string",
              "description": "The committed results this run is compared with, as HEAD:<path>."
            },
            "pass_k": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/definitions/rate"
                }
              ]
            },
            "cases_added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cases_removed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "set_changed": {
              "type": "boolean",
              "description": "The set's git tree differs from the one the previous results were scored on."
            },
            "compared": {
              "type": "boolean",
              "description": "Whether the lower-bound rule compared with these results: only for the same set and the same cases."
            }
          }
        }
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reasons"],
      "properties": {
        "verdict": {
          "enum": ["pass", "block"]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "agent",
          "source",
          "expected",
          "trials",
          "passed",
          "pass_k",
          "pass_rate",
          "trial_results"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REG-[0-9]{3}$"
          },
          "agent": {
            "enum": ["analyst", "test-designer", "healer"]
          },
          "source": {
            "enum": [
              "audit-probe",
              "bench-shop-bug",
              "false-heal",
              "escaped-defect"
            ]
          },
          "expected": {
            "type": "string"
          },
          "trials": {
            "type": "integer",
            "minimum": 1
          },
          "passed": {
            "type": "integer",
            "minimum": 0
          },
          "pass_k": {
            "type": "boolean",
            "description": "Every one of the k trials passed."
          },
          "pass_rate": {
            "$ref": "#/definitions/rate"
          },
          "trial_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["trial", "output_sha256", "pass", "failed"],
              "properties": {
                "trial": {
                  "type": "integer",
                  "minimum": 1
                },
                "output_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "pass": {
                  "type": "boolean"
                },
                "failed": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["check", "detail"],
                    "properties": {
                      "check": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
